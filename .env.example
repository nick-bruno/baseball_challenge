# Supabase Dashboard → Settings → API Keys  (or the "Connect" button up top)
#
# Both values are public and safe to ship to the browser: every table is
# protected by row-level security and all writes go through SECURITY DEFINER
# RPCs. Never put the secret / service_role key in this file.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase's newer "publishable key" (sb_publishable_...) or the legacy "anon"
# key both work. Either variable name is accepted.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX
